<% content_for :title, "Bandejas de emisión" %>
<% content_for :page_title, "Bandejas de emisión" %>

<%#
  El tab "Asignación de bandejas a compañías" del Angular legacy NO está acá: la
  bandeja de cada compañía se elige en la sección "Datos Generales" de su propio
  formulario, al lado de la conexión de SAP. Ver el comentario de cabecera de
  `email_senders_controller.js`.
%>
<div data-controller="email-senders"
     data-testid="email-senders-page"
     class="p-6 flex flex-col h-full">

  <%# Filtros + acción primaria %>
  <div class="mb-4 flex-shrink-0 bg-white rounded-xl shadow-sm border border-gray-100 p-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 items-end">

      <div class="flex flex-col gap-1">
        <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Correo</label>
        <input type="text"
               data-email-senders-target="filterEmail"
               data-action="keydown.enter->email-senders#search"
               data-testid="filter-email"
               placeholder="Correo"
               class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>

      <div class="flex flex-col gap-1">
        <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">SSL</label>
        <%# "Todos" es la cadena vacía: un filtro ausente no filtra, y así no hace
            falta el valor centinela `2` que usaba el API .NET. %>
        <select data-email-senders-target="filterSsl"
                data-testid="filter-ssl"
                class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="">Todos</option>
          <option value="true">Con SSL</option>
          <option value="false">Sin SSL</option>
        </select>
      </div>

      <div class="flex gap-2">
        <button type="button"
                data-action="click->email-senders#search"
                data-testid="btn-search-config"
                class="flex-1 inline-flex items-center justify-center gap-1 px-4 py-2 border border-blue-600 text-blue-600 text-sm font-medium rounded-lg hover:bg-blue-50 transition-colors">
          <span class="material-icons text-base">filter_alt</span>
          Consultar
        </button>
        <%# Nace deshabilitado con el motivo en el tooltip del <span>; el
            controller lo habilita solo si hay permiso (CLAUDE.md §26). %>
        <span data-email-senders-target="btnCreateWrap"
              data-tooltip="No cuenta con permisos para crear bandejas de correo"
              class="flex-1">
          <button type="button"
                  data-email-senders-target="btnCreate"
                  data-action="click->email-senders#openCreatePanel"
                  data-testid="btn-create-inbox"
                  disabled
                  class="w-full inline-flex items-center justify-center gap-1 px-4 py-2 bg-gray-300 text-gray-500 text-sm font-medium rounded-lg cursor-not-allowed pointer-events-none transition-colors">
            <span class="material-icons text-base">add</span>
            Nueva Bandeja
          </button>
        </span>
      </div>

    </div>
  </div>

  <%# Tabla %>
  <div class="flex-1 min-h-0 bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div data-email-senders-target="table"
         data-testid="config-table"
         class="h-full">
    </div>
  </div>

  <%# ── Backdrop panel lateral ──────────────────────────────────────────── %>
  <div data-email-senders-target="panelBackdrop"
       data-action="click->email-senders#closePanel"
       data-testid="panel-backdrop"
       class="hidden fixed inset-0 z-40 bg-black/40">
  </div>

  <%# ── Panel lateral crear/editar bandeja ──────────────────────────────── %>
  <div data-email-senders-target="panel"
       data-testid="inbox-panel"
       class="fixed top-0 right-0 h-full w-full max-w-md bg-white shadow-2xl z-50
              translate-x-full transition-transform duration-300 ease-in-out flex flex-col">

    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 flex-shrink-0">
      <h3 data-email-senders-target="panelTitle"
          data-testid="panel-title"
          class="text-base font-semibold text-gray-800">Información de la bandeja</h3>
      <button type="button"
              data-action="click->email-senders#closePanel"
              class="p-1 text-gray-400 hover:text-gray-600 rounded hover:bg-gray-100 transition-colors">
        <span class="material-icons text-xl">close</span>
      </button>
    </div>

    <%# Un solo `data-action` en el contenedor: cualquier campo que se agregue
        adentro recalcula el estado de los botones sin tener que acordarse de
        cablearlo. %>
    <div class="flex-1 overflow-y-auto px-6 py-5 space-y-4"
         data-action="input->email-senders#onFormChange change->email-senders#onFormChange">

      <%# Correo %>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">
          Correo <span class="text-red-500">*</span>
        </label>
        <input type="email"
               data-email-senders-target="inputEmail"
               data-testid="panel-input-email"
               placeholder="correo@ejemplo.com"
               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <p data-email-senders-target="errorEmail"
           class="hidden mt-1 text-xs text-red-500">El correo es requerido.</p>
        <p data-email-senders-target="errorEmailPattern"
           class="hidden mt-1 text-xs text-red-500">Formato de correo inválido.</p>
      </div>

      <%# Contraseña %>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">
          Contraseña <span data-email-senders-target="passwordAsterisk" class="text-red-500">*</span>
        </label>
        <div class="relative">
          <input type="password"
                 data-email-senders-target="inputPassword"
                 data-testid="panel-input-password"
                 placeholder="Contraseña"
                 autocomplete="new-password"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2 pr-10 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <button type="button"
                  data-action="click->email-senders#togglePassword"
                  class="absolute right-2 top-1/2 -translate-y-1/2 p-1 text-gray-500 hover:text-gray-700">
            <span data-email-senders-target="passwordEyeIcon" class="material-icons text-base">visibility_off</span>
          </button>
        </div>
        <p data-email-senders-target="errorPassword"
           class="hidden mt-1 text-xs text-red-500">La contraseña es requerida.</p>
        <%# La contraseña nunca vuelve del servidor, así que el campo siempre
            carga en blanco y hay que decir qué significa dejarlo así. %>
        <p data-email-senders-target="passwordHint"
           class="hidden mt-1 text-xs text-gray-400">Déjelo en blanco para conservar la contraseña guardada.</p>
      </div>

      <%# A nombre de (SenderAddress) %>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">
          A nombre de
        </label>
        <input type="text"
               data-email-senders-target="inputSenderAddress"
               data-testid="panel-input-sender-address"
               placeholder="Nombre que verá el destinatario"
               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <p class="mt-1 text-xs text-gray-400">Nombre visible del remitente. En blanco se muestra el correo.</p>
      </div>

      <%# Host %>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">
          Host <span class="text-red-500">*</span>
        </label>
        <input type="text"
               data-email-senders-target="inputHost"
               data-testid="panel-input-host"
               placeholder="smtp.ejemplo.com"
               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <p data-email-senders-target="errorHost"
           class="hidden mt-1 text-xs text-red-500">El host es requerido.</p>
      </div>

      <%# Puerto %>
      <div>
        <label class="block text-xs font-medium text-gray-700 mb-1">
          Puerto <span class="text-red-500">*</span>
        </label>
        <input type="number"
               data-email-senders-target="inputPort"
               data-testid="panel-input-port"
               placeholder="587"
               min="1"
               max="65535"
               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <p data-email-senders-target="errorPort"
           class="hidden mt-1 text-xs text-red-500">El puerto es requerido.</p>
      </div>

      <%# SSL %>
      <div>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox"
                 data-email-senders-target="inputSsl"
                 data-testid="panel-input-ssl"
                 checked
                 class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
          <span class="text-sm text-gray-700">Usar SSL/TLS</span>
        </label>
      </div>

      <%# Estado — solo en edición: una bandeja nueva nace activa. %>
      <div data-active-field class="hidden">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox"
                 data-email-senders-target="inputActive"
                 data-testid="panel-input-active"
                 checked
                 class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
          <span class="text-sm text-gray-700">Bandeja activa</span>
        </label>
        <p data-email-senders-target="activeHint"
           class="hidden mt-1 text-xs text-amber-600"></p>
      </div>

      <%# Correo destinatario de la prueba %>
      <div class="pt-2 border-t border-gray-100">
        <label class="block text-xs font-medium text-gray-700 mb-1">
          Correo destinatario de prueba <span class="text-red-500">*</span>
        </label>
        <input type="email"
               data-email-senders-target="inputTestEmail"
               data-testid="panel-input-test-email"
               placeholder="correo@ejemplo.com"
               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <p class="mt-1 text-xs text-gray-400">
          Al probar se envía un correo real a esta dirección: es la única forma de
          comprobar que el servidor deja salir el mensaje, y no solo que la
          contraseña es correcta.
        </p>
      </div>

    </div><%# /cuerpo %>

    <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3 flex-shrink-0">
      <button type="button"
              data-action="click->email-senders#closePanel"
              data-testid="btn-cancel-panel"
              class="inline-flex items-center gap-1 px-4 py-2 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-colors">
        <span class="material-icons text-base">cancel</span>
        Cancelar
      </button>

      <button type="button"
              data-action="click->email-senders#validateCredentials"
              data-email-senders-target="btnValidate"
              data-testid="btn-validate"
              class="inline-flex items-center gap-1 px-4 py-2 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        <span data-email-senders-target="validateIcon" class="material-icons text-base">wifi_tethering</span>
        <span data-email-senders-target="validateLabel">Probar bandeja</span>
      </button>

      <%# El motivo de estar deshabilitado va en el <span>: un <button disabled>
          no emite eventos de mouse (CLAUDE.md §2 y §26). %>
      <span data-email-senders-target="saveBtnWrap"
            data-tooltip="Debe probar la bandeja antes de guardarla">
        <button type="button"
                data-action="click->email-senders#save"
                data-email-senders-target="saveBtn"
                data-testid="btn-save"
                disabled
                class="inline-flex items-center gap-1 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed pointer-events-none">
          <span class="material-icons text-base">save</span>
          <span data-email-senders-target="saveLabel">Guardar</span>
        </button>
      </span>
    </div>

  </div><%# /panel %>

</div><%# /page %>
