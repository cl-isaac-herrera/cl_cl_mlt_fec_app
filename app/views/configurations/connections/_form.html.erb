<%# Partial compartido por new.html.erb y edit.html.erb %>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">

  <%# Panel header %>
  <div class="px-6 py-4 border-b border-gray-100">
    <h3 class="text-base font-semibold text-gray-800">Configuración de Conexión SAP</h3>
  </div>

  <%# Formulario %>
  <div class="px-6 py-5">
    <div data-testid="connection-form"
         data-action="input->connection-form#refreshSubmitState change->connection-form#refreshSubmitState"
         class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">

      <%# Nombre %>
      <div class="md:col-span-2 flex flex-col gap-1">
        <label class="text-sm font-medium text-gray-700">
          Nombre <span class="text-red-500">*</span>
        </label>
        <input type="text"
               data-connection-form-target="name"
               data-testid="input-name"
               placeholder="SAP Producción"
               class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <p data-connection-form-target="nameError"
           class="hidden text-xs text-red-500">El nombre es requerido.</p>
      </div>

      <%# URL del Service Layer %>
      <div class="md:col-span-2 flex flex-col gap-1">
        <label class="text-sm font-medium text-gray-700">
          URL del Service Layer <span class="text-red-500">*</span>
        </label>
        <input type="text"
               data-connection-form-target="slUrl"
               data-testid="input-sl-url"
               placeholder="https://servidor:50000/b1s/v1"
               class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <p data-connection-form-target="slUrlError"
           class="hidden text-xs text-red-500">La URL debe empezar con http:// o https://.</p>
      </div>

      <%# ------------------------------------------------------------ %>
      <%# Credenciales de licencia de SAP %>
      <%# Las usa la sincronización de emitidos, que corre sin nadie en sesión. %>
      <%# ------------------------------------------------------------ %>
      <div class="md:col-span-2 pt-2 mt-1 border-t border-gray-100">
        <h4 class="text-sm font-semibold text-gray-700">Credenciales de licencia de SAP</h4>
        <p class="mt-1 text-xs text-gray-500">
          Con estas credenciales se autentican los procesos que hablan con SAP sin una
          persona detrás, como la sincronización de documentos emitidos. Son del servidor,
          no de un usuario de la aplicación.
        </p>
      </div>

      <%# Usuario de licencia %>
      <div class="md:col-span-2 flex flex-col gap-1">
        <label class="text-sm font-medium text-gray-700">Usuario de licencia</label>
        <input type="text"
               data-connection-form-target="sapLicense"
               data-testid="input-sap-license"
               autocomplete="off"
               placeholder="manager"
               class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>

      <%# Contraseña de licencia — toggle de visibilidad (CLAUDE.md §4) %>
      <div class="md:col-span-2 flex flex-col gap-1">
        <label class="text-sm font-medium text-gray-700">Contraseña de licencia</label>
        <div class="relative">
          <input type="password"
                 data-connection-form-target="sapLicensePassword"
                 data-testid="input-sap-license-password"
                 autocomplete="new-password"
                 placeholder="Contraseña de licencia"
                 class="w-full border border-gray-300 rounded-lg px-3 py-2 pr-10 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <button type="button"
                  data-action="click->connection-form#toggleLicensePassword"
                  data-testid="btn-toggle-password"
                  aria-label="Mostrar/ocultar contraseña"
                  class="absolute right-2 top-1/2 -translate-y-1/2 p-1 text-gray-500 hover:text-gray-700">
            <span data-connection-form-target="eyeIcon" class="material-icons text-base">visibility_off</span>
          </button>
        </div>
        <p data-connection-form-target="sapLicensePasswordHint" class="hidden text-xs text-gray-500">
          Ya hay una contraseña guardada. Déjelo en blanco para conservarla.
        </p>
      </div>

      <%# Base de datos de SAP — solo para la prueba, no se guarda %>
      <div class="md:col-span-2 flex flex-col gap-1">
        <label class="text-sm font-medium text-gray-700">Base de datos de SAP para la prueba</label>
        <input type="text"
               data-connection-form-target="companyDb"
               data-testid="input-company-db"
               list="connection-form-sap-dbs"
               autocomplete="off"
               placeholder="SBO_EMPRESA"
               class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <datalist id="connection-form-sap-dbs" data-connection-form-target="companyDbList"></datalist>
        <p class="text-xs text-gray-500">
          No se guarda en la conexión: el Service Layer exige una base para iniciar sesión.
          La licencia es del servidor, así que cualquiera de sus bases sirve para comprobarla.
        </p>
      </div>

      <%# Botón: comprobar credenciales de SAP %>
      <div class="md:col-span-2">
        <button type="button"
                data-connection-form-target="btnTestLicense"
                data-testid="btn-test-license"
                data-action="click->connection-form#testLicense"
                disabled
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-blue-400 text-blue-600 text-sm font-medium hover:bg-blue-50 transition-all duration-300 disabled:opacity-40 disabled:cursor-not-allowed">
          <span data-connection-form-target="testLicenseIcon" class="material-icons text-base">wifi_tethering</span>
          <span data-connection-form-target="testLicenseLabel">Comprobar credenciales de SAP</span>
        </button>
      </div>

    </div>
  </div>

  <%# Footer con botones %>
  <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3">
    <button type="button"
            data-testid="btn-cancel"
            data-action="click->connection-form#cancel"
            class="inline-flex items-center gap-1 px-4 py-2 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-colors">
      <span class="material-icons text-base">cancel</span>
      Cancelar
    </button>
    <button type="button"
            data-connection-form-target="submitBtn"
            data-testid="btn-submit"
            data-action="click->connection-form#save"
            class="inline-flex items-center gap-1 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
      <span data-connection-form-target="submitIcon" class="material-icons text-base">save</span>
      <span data-connection-form-target="submitLabel">Crear</span>
    </button>
  </div>

</div>

