<% content_for :title, "Conexiones SAP" %>
<% content_for :page_title, "Gestión de Conexiones SAP" %>

<div data-controller="connections"
     data-testid="connections-page"
     class="p-6 flex flex-col h-full">

  <%# ---------------------------------------------------------------- %>
  <%# HEADER: búsqueda + botones %>
  <%# ---------------------------------------------------------------- %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-4 flex-shrink-0">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 items-end">

      <%# Nombre %>
      <div class="flex flex-col gap-1">
        <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Nombre</label>
        <input type="text"
               data-connections-target="inputName"
               data-testid="input-name"
               placeholder="Nombre de la conexión"
               class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>

      <%# URL del Service Layer %>
      <div class="flex flex-col gap-1">
        <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">URL del Service Layer</label>
        <input type="text"
               data-connections-target="inputSlUrl"
               data-testid="input-sl-url"
               placeholder="https://servidor:50000/b1s/v1"
               class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>

      <%# Botones Consultar / Crear %>
      <div class="flex gap-2">
        <button type="button"
                data-testid="btn-search"
                data-action="click->connections#search"
                class="flex-1 inline-flex items-center justify-center gap-1 px-4 py-2 border border-blue-600 text-blue-600 text-sm font-medium rounded-lg hover:bg-blue-50 transition-colors">
          <span class="material-icons text-base">filter_alt</span>
          Consultar
        </button>

        <span data-connections-target="btnCreateWrap"
              data-tooltip="No cuenta con permisos para crear conexiones"
              class="flex-1">
          <button type="button"
                  data-connections-target="btnCreate"
                  data-testid="btn-create"
                  data-action="click->connections#openCreatePanel"
                  disabled
                  class="w-full inline-flex items-center justify-center gap-1 px-4 py-2 bg-gray-300 text-gray-500 text-sm font-medium rounded-lg cursor-not-allowed pointer-events-none transition-colors">
            <span class="material-icons text-base">add</span>
            Nueva Conexión
          </button>
        </span>
      </div>

    </div>
  </div>

  <%# ---------------------------------------------------------------- %>
  <%# TABLA DE CONEXIONES (Tabulator full-height, paginación remota) %>
  <%# ---------------------------------------------------------------- %>
  <div class="flex-1 min-h-0 bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div data-connections-target="table" data-testid="connections-table" class="h-full"></div>
  </div>

  <%# ================================================================ %>
  <%# PANEL LATERAL DERECHO — Crear / Editar Conexión SAP %>
  <%# Reemplaza la navegación a /connections/new y /:id/edit (CLAUDE.md §8). %>
  <%# ================================================================ %>

  <%# Backdrop %>
  <div data-connections-target="panelBackdrop"
       data-action="click->connections#closePanel"
       class="hidden fixed inset-0 z-40 bg-black/40"></div>

  <%# Panel deslizable desde la derecha %>
  <div data-connections-target="panel"
       data-testid="connection-panel"
       data-action="input->connections#refreshSubmitState change->connections#refreshSubmitState"
       class="fixed top-0 right-0 h-full w-full max-w-lg bg-white shadow-2xl z-50
              translate-x-full transition-transform duration-300 ease-in-out flex flex-col">

    <%# Header %>
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 flex-shrink-0">
      <h3 data-connections-target="panelTitle" class="text-base font-semibold text-gray-800">Nueva Conexión SAP</h3>
      <button type="button"
              data-action="click->connections#closePanel"
              data-testid="connection-panel-close"
              class="p-1 text-gray-400 hover:text-gray-600 rounded hover:bg-gray-100 transition-colors">
        <span class="material-icons text-xl">close</span>
      </button>
    </div>

    <%# Cuerpo — campos del formulario %>
    <div class="flex-1 overflow-y-auto px-6 py-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

        <%# Nombre %>
        <div class="sm:col-span-2 flex flex-col gap-1">
          <label class="text-xs font-medium text-gray-600">Nombre <span class="text-red-500">*</span></label>
          <input type="text"
                 data-connections-target="fName"
                 data-testid="panel-input-name"
                 placeholder="SAP Producción"
                 class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <span data-connections-target="fNameError" class="hidden text-xs text-red-500">El nombre es requerido.</span>
        </div>

        <%# URL del Service Layer %>
        <div class="sm:col-span-2 flex flex-col gap-1">
          <label class="text-xs font-medium text-gray-600">URL del Service Layer <span class="text-red-500">*</span></label>
          <input type="text"
                 data-connections-target="fSlUrl"
                 data-testid="panel-input-sl-url"
                 placeholder="https://servidor:50000/b1s/v1"
                 class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <span data-connections-target="fSlUrlError" class="hidden text-xs text-red-500">La URL debe empezar con http:// o https://.</span>
        </div>

        <%# ------------------------------------------------------------ %>
        <%# Credenciales de licencia de SAP %>
        <%# Las usa la sincronización de emitidos, que corre sin nadie en sesión. %>
        <%# ------------------------------------------------------------ %>
        <div class="sm:col-span-2 pt-2 mt-1 border-t border-gray-100">
          <h4 class="text-sm font-semibold text-gray-700">Credenciales de licencia de SAP</h4>
          <p class="mt-1 text-xs text-gray-500">
            Con estas credenciales se autentican los procesos que hablan con SAP sin una
            persona detrás, como la sincronización de documentos emitidos. Son del servidor,
            no de un usuario de la aplicación.
          </p>
        </div>

        <%# Usuario de licencia %>
        <div class="sm:col-span-2 flex flex-col gap-1">
          <label class="text-xs font-medium text-gray-600">Usuario de licencia</label>
          <input type="text"
                 data-connections-target="fSapLicense"
                 data-testid="panel-input-sap-license"
                 autocomplete="off"
                 placeholder="manager"
                 class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <%# Contraseña de licencia — toggle de visibilidad (CLAUDE.md §4) %>
        <div class="sm:col-span-2 flex flex-col gap-1">
          <label class="text-xs font-medium text-gray-600">Contraseña de licencia</label>
          <div class="relative">
            <input type="password"
                   data-connections-target="fSapLicensePassword"
                   data-testid="panel-input-sap-license-password"
                   autocomplete="new-password"
                   placeholder="Contraseña de licencia"
                   class="w-full border border-gray-300 rounded-lg px-3 py-2 pr-10 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <button type="button"
                    data-action="click->connections#toggleLicensePassword"
                    data-testid="panel-btn-toggle-password"
                    aria-label="Mostrar/ocultar contraseña"
                    class="absolute right-2 top-1/2 -translate-y-1/2 p-1 text-gray-500 hover:text-gray-700">
              <span data-connections-target="fEyeIcon" class="material-icons text-base">visibility_off</span>
            </button>
          </div>
          <span data-connections-target="fSapLicensePasswordHint" class="hidden text-xs text-gray-500">
            Ya hay una contraseña guardada. Déjelo en blanco para conservarla.
          </span>
        </div>

        <%# Base de datos de SAP — solo para la prueba, no se guarda %>
        <div class="sm:col-span-2 flex flex-col gap-1">
          <label class="text-xs font-medium text-gray-600">Base de datos de SAP para la prueba</label>
          <input type="text"
                 data-connections-target="fCompanyDb"
                 data-testid="panel-input-company-db"
                 list="connection-sap-dbs"
                 autocomplete="off"
                 placeholder="SBO_EMPRESA"
                 class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <datalist id="connection-sap-dbs" data-connections-target="fCompanyDbList"></datalist>
          <span class="text-xs text-gray-500">
            No se guarda en la conexión: el Service Layer exige una base para iniciar sesión.
            La licencia es del servidor, así que cualquiera de sus bases sirve para comprobarla.
          </span>
        </div>

        <%# Botón: comprobar credenciales de SAP %>
        <div class="sm:col-span-2">
          <button type="button"
                  data-connections-target="btnTestLicense"
                  data-testid="panel-btn-test-license"
                  data-action="click->connections#testLicense"
                  disabled
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-blue-400 text-blue-600 text-sm font-medium hover:bg-blue-50 transition-all duration-300 disabled:opacity-40 disabled:cursor-not-allowed">
            <span data-connections-target="testLicenseIcon" class="material-icons text-base">wifi_tethering</span>
            <span data-connections-target="testLicenseLabel">Comprobar credenciales de SAP</span>
          </button>
        </div>

      </div>
    </div>

    <%# Footer %>
    <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3 flex-shrink-0">
      <button type="button"
              data-action="click->connections#closePanel"
              data-testid="panel-btn-cancel"
              class="inline-flex items-center gap-1 px-4 py-2 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-colors">
        <span class="material-icons text-base">cancel</span>
        Cancelar
      </button>
      <button type="button"
              data-action="click->connections#savePanel"
              data-connections-target="submitBtn"
              data-testid="panel-btn-submit"
              class="inline-flex items-center gap-1 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        <span data-connections-target="submitIcon" class="material-icons text-base">check</span>
        <span data-connections-target="submitLabel">Crear conexión</span>
      </button>
    </div>

  </div>

</div>
