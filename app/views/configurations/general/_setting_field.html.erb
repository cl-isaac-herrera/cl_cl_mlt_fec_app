<%#
  Campo de un ajuste de la instalación (tabla `settings`).

  El input NO se declara como un target propio: todos comparten el target
  `settingInput` y se identifican por `data-setting-code`, que es la llave
  natural del recurso y la que va en `PATCH /api/settings/:code`. Así agregar un
  ajuste al catálogo es agregar un render acá, sin tocar la lista de targets del
  controller.

  Locals:
    code        — `code` del ajuste (obligatorio)
    label       — etiqueta visible (obligatorio)
    type        — 'text' | 'password' | 'number' | 'select'  (default: 'text')
    placeholder — placeholder del input
    hint        — texto de ayuda bajo el campo
    options     — [[valor, etiqueta], …] cuando type == 'select'
%>
<% type        = local_assigns.fetch(:type, 'text') %>
<% placeholder = local_assigns[:placeholder] %>
<% hint        = local_assigns[:hint] %>
<% input_class = 'w-full border border-gray-300 rounded-lg px-3 py-2 text-sm ' \
                 'focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent' %>

<div>
  <label class="block text-sm font-medium text-gray-700 mb-1"><%= label %></label>

  <% if type == 'select' %>
    <select data-general-configs-target="settingInput"
            data-setting-code="<%= code %>"
            data-action="change->general-configs#onSettingInput"
            data-testid="setting-<%= code %>"
            class="<%= input_class %> bg-white">
      <option value=""><%= placeholder || 'Seleccione…' %></option>
      <% Array(local_assigns[:options]).each do |value, text| %>
        <option value="<%= value %>"><%= text %></option>
      <% end %>
    </select>

  <% elsif type == 'password' %>
    <%# El valor de un ajuste oculto no sale del servidor: el input nace vacío y
        el placeholder dice si ya hay una contraseña guardada. %>
    <div class="relative" data-secret-field>
      <input type="password"
             data-general-configs-target="settingInput"
             data-setting-code="<%= code %>"
             data-action="input->general-configs#onSettingInput"
             data-testid="setting-<%= code %>"
             placeholder="<%= placeholder %>"
             autocomplete="new-password"
             class="<%= input_class %> pr-10">
      <button type="button"
              data-action="click->general-configs#toggleSecret"
              title="Mostrar/ocultar"
              class="absolute right-2 top-1/2 -translate-y-1/2 p-1 text-gray-500 hover:text-gray-700 transition-colors">
        <span class="material-icons text-base">visibility_off</span>
      </button>
    </div>

  <% else %>
    <input type="<%= type %>"
           data-general-configs-target="settingInput"
           data-setting-code="<%= code %>"
           data-action="input->general-configs#onSettingInput"
           data-testid="setting-<%= code %>"
           placeholder="<%= placeholder %>"
           class="<%= input_class %>">
  <% end %>

  <%# El texto de ayuda cambia con el motor: el puerto es obligatorio en HANA y
      la base de datos no entra al DSN. Lo reescribe `#applyEngineHints()`. %>
  <p data-general-configs-target="settingHint"
     data-setting-code="<%= code %>"
     class="mt-1 text-xs text-gray-400 <%= 'hidden' if hint.blank? %>"><%= hint %></p>
</div>
