<%#
  Loader a nivel de sección (lectura, sin texto) — CLAUDE.md §15.

  Cada card de esta pantalla hace su propia consulta, así que cada uno se tapa
  solo mientras carga en vez de bloquear la página con el overlay global.

  Locals:
    target — nombre del Stimulus target del contenedor
    group  — (opcional) grupo de `settings` al que pertenece, para que el
             controller lo encuentre entre varios loaders con el mismo target
%>
<div data-general-configs-target="<%= target %>"
     <% if local_assigns[:group].present? %>data-setting-group="<%= group %>"<% end %>
     class="hidden absolute inset-0 z-30 flex items-center justify-center bg-white/60 rounded-xl">
  <svg width="40" height="40" viewBox="0 0 50 50" aria-hidden="true">
    <circle cx="25" cy="25" r="20" fill="none" stroke="#e5e7eb" stroke-width="5"></circle>
    <circle cx="25" cy="25" r="20" fill="none" stroke="#2563eb" stroke-width="5"
            stroke-linecap="round" stroke-dasharray="80 200">
      <animateTransform attributeName="transform" attributeType="XML" type="rotate"
                        from="0 25 25" to="360 25 25" dur="0.8s" repeatCount="indefinite"></animateTransform>
    </circle>
  </svg>
</div>
