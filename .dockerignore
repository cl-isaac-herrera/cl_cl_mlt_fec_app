# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (FILES_BASE_PATH por default: certificados/logos/formatos de
# compañía, ver CLAUDE.md #34) y las bases SQLite (primary/queue/cache, ver el
# comentario de config/database.yml) — este proyecto las guarda en db/, no en
# storage/, a diferencia del default genérico de `rails new`.
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*
